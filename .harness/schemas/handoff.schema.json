{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/handoff.schema.json",
  "title": "handoff.yaml -- structured OPEN items whose `until:` a machine can evaluate (Harness v3, Dot A)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "open"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "open": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "until"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,60}$" },
          "text": { "type": "string", "minLength": 1 },
          "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "until_note": { "type": "string", "description": "the retiring condition in words, when until is manual" },
          "until": {
            "type": "string",
            "description": "manual | file_absent: <rel> | file_present: <rel> | git_merged: <ref> | git_pushed: <remote/branch> | ci_green: <sha> | receipt_version_min: x.y.z",
            "pattern": "^(manual|file_absent: .+|file_present: .+|git_merged: .+|git_pushed: .+|ci_green: [0-9a-fA-F]{7,40}|receipt_version_min: \\d+\\.\\d+\\.\\d+)$"
          }
        }
      }
    }
  }
}
