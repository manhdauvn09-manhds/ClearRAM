{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash",
      "PowerShell",
      "Edit",
      "Write",
      "NotebookEdit"
    ],
    "ask": [
      "Agent",
      "Workflow",
      "Skill",
      "CronCreate",
      "CronDelete",
      "TodoWrite"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod -R:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(del /F /S:*)",
      "PowerShell(Remove-Item -Recurse -Force:*)",
      "PowerShell(Start-Process -Verb RunAs:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-session-start.ps1"
            ]
          },
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-worktree.ps1",
              "start"
            ]
          },
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harnessd.ps1",
              "ensure"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/injection-scan.ps1"
            ]
          },
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harnessd.ps1",
              "ensure"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47631/hook/pre-tool-use",
            "timeout": 20,
            "headers": {
              "X-Harnessd-Token": "$HARNESSD_TOKEN"
            },
            "allowedEnvVars": [
              "HARNESSD_TOKEN"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47631/hook/post-tool-use",
            "timeout": 20,
            "headers": {
              "X-Harnessd-Token": "$HARNESSD_TOKEN"
            },
            "allowedEnvVars": [
              "HARNESSD_TOKEN"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/agentops-sampler.ps1"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-handoff-check.ps1"
            ]
          },
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-worktree.ps1",
              "stop"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.harness/scripts/powershell/harness-session-end.ps1"
            ]
          }
        ]
      }
    ]
  }
}
