{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Readonly app-data preview catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "governs",
    "executionEnabled",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "governs": {
      "const": "product_runtime"
    },
    "executionEnabled": {
      "const": false
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "knownFolder",
          "relativeRoot",
          "layout",
          "installNames",
          "publishers",
          "executables",
          "cacheBranches",
          "protectedBranches",
          "cacheEffect",
          "personalEffect",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "knownFolder": {
            "enum": [
              "Local",
              "Roaming"
            ]
          },
          "relativeRoot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "layout": {
            "enum": [
              "Chromium",
              "Flat"
            ]
          },
          "installNames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "publishers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "executables": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "cacheBranches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "protectedBranches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "cacheEffect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "personalEffect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
