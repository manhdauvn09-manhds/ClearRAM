<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MemoryClear · Duyệt kế hoạch" Width="1000" Height="700" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F3F6F1">
 <Grid Margin="22" Background="#F3F6F1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="#173C33" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Duyệt phạm vi và tác động" FontSize="26" Foreground="#D7F49B"/><TextBlock x:Name="ReviewHeading" Foreground="White" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
 <StackPanel Grid.Row="1" Margin="0,12"><TextBlock x:Name="ReviewSummary" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Dung lượng là metadata của mục đủ điều kiện trong bản xem trước; chưa phải dung lượng đã giải phóng. Xác nhận không bỏ qua bảo vệ." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#586B60"/></StackPanel>
 <DataGrid x:Name="ReviewItems" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" EnableRowVirtualization="True" Background="White"><DataGrid.Columns>
 <DataGridTemplateColumn Header="Đã đọc" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Reviewed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReview}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="Mục / đường dẫn" Width="280" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="5" ToolTip="{Binding Path}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" FontSize="11" Foreground="#586B60" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Xử lý" Binding="{Binding RiskLabel}" Width="120" IsReadOnly="True"/><DataGridTextColumn Header="MB (allocated)" Binding="{Binding AllocatedMB}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Hậu quả / lý do" Binding="{Binding Description}" Width="*" MinWidth="230" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
 </DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="3" Margin="0,14,0,0"><Border x:Name="ReviewFinalPanel" Background="#FFF0DB" Padding="14" CornerRadius="8" Visibility="Collapsed"><StackPanel><TextBlock Text="02 · Xác nhận hậu quả" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Phương án xóa vĩnh viễn có thể làm mất dữ liệu và không có Undo. Cửa sổ này chỉ kiểm tra luồng duyệt, không thực hiện xóa." TextWrapping="Wrap" Margin="0,7,0,7"/><CheckBox x:Name="ReviewAcknowledge" Content="Tôi đã đọc phạm vi và hậu quả của những mục đủ điều kiện"/><TextBlock x:Name="ReviewPhraseHint" Margin="0,8,0,5" TextWrapping="Wrap"/><TextBox x:Name="ReviewPhrase" Height="30"/></StackPanel></Border><TextBlock x:Name="ReviewStatus" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#173C33"/></StackPanel>
 <WrapPanel Grid.Row="4" Margin="0,14,0,0" HorizontalAlignment="Right"><Button x:Name="ReviewBack" Content="Quay lại bước 1" Padding="14,9" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="ReviewNext" Content="Tiếp tục duyệt" Padding="14,9" Margin="0,0,8,0"/><Button x:Name="ReviewConfirm" Content="Hoàn tất duyệt thử · không xóa" Padding="14,9" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="ReviewClose" Content="Đóng" Padding="14,9"/></WrapPanel>
 </Grid>
</Window>
