<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MemoryClear — Giao dịch và phục hồi dữ liệu mẫu" Width="1000" Height="760" MinWidth="780" MinHeight="640" Background="#F3F6F1" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CAD9CD"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#CAD9CD"/></Style></Window.Resources>
 <Grid Margin="22" Background="#F3F6F1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="#173C33" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Giao dịch · Sao lưu · Phục hồi" Foreground="#D7F49B" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="OperationHeading" Text="Dữ liệu mẫu riêng trong project · xóa thật ngoài fixture vẫn khóa" Foreground="#D2E2D5" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
 <TabControl x:Name="OperationTabs" Grid.Row="1" Margin="0,14,0,12" Background="#F3F6F1"><TabItem Header="Phạm vi và tác động"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="OperationSummary" TextWrapping="Wrap"/><WrapPanel Margin="0,10,0,10"><RadioButton x:Name="OperationBackup" Content="Sao lưu trước khi xóa" IsChecked="True" GroupName="Mode" Margin="0,0,18,0"/><RadioButton x:Name="OperationPermanent" Content="Xóa vĩnh viễn" GroupName="Mode"/><TextBlock x:Name="OperationBackupHint" Text="Backup cùng ổ: chưa thu hồi chỗ" Margin="18,0,0,0" Foreground="#657A6B"/></WrapPanel></StackPanel>
 <DataGrid Grid.Row="1" x:Name="OperationItems" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" Background="White" BorderBrush="#CAD9CD"><DataGrid.Columns>
 <DataGridTemplateColumn Header="Đã đọc" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" IsChecked="{Binding Reviewed,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReview}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="File / đường dẫn" Width="275" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" FontSize="10" Foreground="#657A6B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTextColumn Header="Mức" Binding="{Binding RiskLabel}" Width="95" IsReadOnly="True"/><DataGridTextColumn Header="Tác động" Binding="{Binding Effect}" Width="350" MinWidth="300" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="5"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
 </DataGrid.Columns></DataGrid>
 <Border x:Name="OperationFinal" Grid.Row="2" Background="#FFF1D7" Padding="12" Margin="0,10,0,0" Visibility="Collapsed"><StackPanel><CheckBox x:Name="OperationAck" Content="Tôi đã đọc hậu quả cho đúng danh sách này"/><TextBlock x:Name="OperationPhraseHint" Margin="0,7,0,5" TextWrapping="Wrap"/><TextBox x:Name="OperationPhrase"/></StackPanel></Border>
 </Grid></TabItem><TabItem Header="Nhật ký và phục hồi"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><DockPanel><Button x:Name="OperationRecent" Content="Nhật ký gần đây" DockPanel.Dock="Left"/><ComboBox x:Name="OperationRecentRuns" DisplayMemberPath="Label" Margin="0,0,0,8" ToolTip="Chọn nhật ký để kiểm tra; các dòng chưa đọc không là giao dịch thành công"/></DockPanel><DockPanel><Button x:Name="OperationInspect" Content="Kiểm tra nhật ký" DockPanel.Dock="Right"/><TextBox x:Name="OperationJournal" ToolTip="Chỉ journal của dữ liệu mẫu có marker; không resume xóa tự động"/></DockPanel></StackPanel>
 <TextBlock x:Name="OperationHistoryStatus" Grid.Row="1" Text="Chưa đọc nhật ký; chưa có bằng chứng giao dịch." TextWrapping="Wrap" Margin="0,10,0,10" Foreground="#657A6B"/>
 <DataGrid x:Name="OperationHistory" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Background="White"><DataGrid.Columns><DataGridTextColumn Header="Đích phục hồi" Binding="{Binding Path}" Width="330" MinWidth="280"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="5"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Nguồn" Binding="{Binding SourceLabel}" Width="150"/><DataGridTextColumn Header="Backup" Binding="{Binding BackupLabel}" Width="150"/><DataGridCheckBoxColumn Header="Có thể phục hồi" Binding="{Binding CanRestore}" Width="100"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="Phục hồi tạo file mới tại đường dẫn cũ, không ghi đè. Backup được giữ. Nhật ký thiếu dòng cuối không chứng minh giao dịch đã hoàn tất." TextWrapping="Wrap" Foreground="#657A6B"/><WrapPanel Margin="0,8,0,0"><CheckBox x:Name="OperationRestoreAck" Content="Đã kiểm tra đúng đích phục hồi" VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="OperationRestore" Content="Phục hồi mục đã chọn" IsEnabled="False"/></WrapPanel></StackPanel>
 </Grid></TabItem></TabControl>
 <StackPanel Grid.Row="2"><ProgressBar x:Name="OperationProgress" Height="7" Foreground="#176B51"/><TextBlock x:Name="OperationStatus" Text="Chưa thực thi; chỉ file mẫu mới có quyền giao dịch." TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button x:Name="OperationNext" Content="Duyệt danh sách"/><Button x:Name="OperationConfirm" Content="Xác nhận cuối" IsEnabled="False"/><Button x:Name="OperationBack" Content="Quay lại" IsEnabled="False"/><Button x:Name="OperationRun" Content="Chạy trên file mẫu" IsEnabled="False" Background="#D7F49B"/><Button x:Name="OperationStop" Content="Dừng" IsEnabled="False"/><Button x:Name="OperationClose" Content="Đóng"/></WrapPanel></StackPanel>
 </Grid>
</Window>
