<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="Level1Card" TargetType="Border"><Setter Property="BorderBrush" Value="#CAD9CD"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=DiskLevel1}" Value="True"><Setter Property="BorderBrush" Value="#176B51"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="Level2Card" TargetType="Border"><Setter Property="BorderBrush" Value="#CAD9CD"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=DiskLevel2}" Value="True"><Setter Property="BorderBrush" Value="#176B51"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="Level3Card" TargetType="Border"><Setter Property="BorderBrush" Value="#CAD9CD"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=DiskLevel3}" Value="True"><Setter Property="BorderBrush" Value="#176B51"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="#173C33" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="Clean dữ liệu ổ Windows" FontSize="27" Foreground="#D7F49B" FontWeight="SemiBold"/><TextBlock x:Name="DiskScope" Foreground="#D2E2D5" Margin="0,7,0,0" TextWrapping="Wrap" Text="Scanner chỉ đọc · chưa xóa file · không xin admin"/></StackPanel></Border>
 <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,12">
  <Border Background="White" Style="{StaticResource Level1Card}" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><RadioButton x:Name="DiskLevel1" GroupName="DiskLevel" IsChecked="True" Content="01 · Tiêu chuẩn" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Temp cũ ≥7 ngày; giữ file mới." Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Background="White" Style="{StaticResource Level2Card}" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><RadioButton x:Name="DiskLevel2" GroupName="DiskLevel" Content="02 · Chuyên sâu" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Temp/cache hệ thống qua Windows Storage." Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Background="White" Style="{StaticResource Level3Card}" CornerRadius="10" Padding="14"><StackPanel><RadioButton x:Name="DiskLevel3" GroupName="DiskLevel" Content="03 · Tối đa có duyệt" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Temp ≥3 ngày; user data vẫn giữ." Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
 </UniformGrid>
 <StackPanel Grid.Row="2" Margin="0,0,0,12">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DiskSearch" ToolTip="Lọc tên, đường dẫn, chủ sở hữu hoặc tác động trong trang hiện tại"/><CheckBox x:Name="DiskLarge" Grid.Column="1" Content="Tìm file lớn / cũ" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="DiskScan" Grid.Column="2" Content="Quét chỉ đọc"/><Button x:Name="DiskAnalyze" Grid.Column="3" Content="Phân tích ứng dụng" IsEnabled="False" ToolTip="Đối chiếu trang hiện tại với thông tin cài đặt và process/service/task; chỉ đọc, không tự xóa"/><Button x:Name="DiskStop" Grid.Column="4" Content="Dừng" IsEnabled="False" Margin="0"/></Grid>
 <WrapPanel Margin="0,8,0,0"><CheckBox x:Name="DiskAppData" Content="Cache / dữ liệu app còn sót" VerticalAlignment="Center" ToolTip="Quét AppData mặc định Chrome, Edge, VS Code; phân loại cache và dữ liệu cá nhân. Không chứng minh đã gỡ và không tự xóa."/><TextBlock Text="Chrome · Edge · VS Code | đối chiếu cài đặt bằng Phân tích ứng dụng" Margin="14,0,0,0" Foreground="#657A6B" VerticalAlignment="Center"/></WrapPanel>
 <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
 <TextBlock Text="Tối thiểu MB" VerticalAlignment="Center"/><TextBox x:Name="DiskMinimumMB" Text="512" Width="65" Margin="7,0,12,0" ToolTip="1–1048576 MB; chỉ áp dụng tìm file lớn"/>
 <TextBlock Text="Tuổi ≥ ngày" VerticalAlignment="Center"/><TextBox x:Name="DiskMinimumAge" Text="0" Width="50" Margin="7,0,12,0" ToolTip="0 = mọi tuổi; dựa trên lần ghi, không chứng minh file không dùng"/>
 <TextBlock Text="Đuôi file" VerticalAlignment="Center"/><TextBox x:Name="DiskExtensions" Width="140" Margin="7,0,12,0" ToolTip="Ví dụ .iso,.zip,.log; để trống để tìm mọi loại"/>
 <Button x:Name="DiskChooseFolder" Content="Chọn thư mục..." ToolTip="Chỉ thư mục con cá nhân Documents/Downloads/Desktop/Pictures/Videos trên ổ Windows; cloud/nguồn code được bảo vệ"/>
 <Button x:Name="DiskResetFolder" Content="Tất cả thư mục cá nhân"/>
 </WrapPanel><TextBlock x:Name="DiskFolderHint" Text="Tìm file: các thư mục cá nhân trên ổ Windows · mọi ứng viên đều cần duyệt" Margin="0,7,0,0" Foreground="#657A6B" TextWrapping="Wrap"/>
 </StackPanel>
 <DataGrid x:Name="DiskFiles" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="White" BorderBrush="#CAD9CD" SelectionMode="Extended"><DataGrid.Columns>
 <DataGridTextColumn Header="File / app" Binding="{Binding Name}" Width="180" MinWidth="180"/><DataGridTextColumn Header="Allocated MB" Binding="{Binding AllocatedMB}" Width="95" MinWidth="95"/><DataGridTextColumn Header="Logical MB" Binding="{Binding LogicalMB}" Width="95" MinWidth="95"/><DataGridTextColumn Header="Tuổi ngày" Binding="{Binding AgeDays}" Width="75" MinWidth="75"/><DataGridTextColumn Header="Phân loại" Binding="{Binding RiskLabel}" Width="130" MinWidth="130"/><DataGridTextColumn Header="Ứng dụng / tham chiếu" Binding="{Binding OwnerLabel, TargetNullValue=Chưa phân tích, FallbackValue=Chưa phân tích}" Width="220" MinWidth="220"/><DataGridTextColumn Header="Tác động / giới hạn" Binding="{Binding Effect}" Width="320" MinWidth="320"/><DataGridTextColumn Header="Đường dẫn" Binding="{Binding Path}" Width="*" MinWidth="150"/>
 </DataGrid.Columns></DataGrid>
 <Border Grid.Row="4" Background="#E7EFDF" CornerRadius="9" Padding="13" Margin="0,14,0,0"><StackPanel><DockPanel><TextBlock x:Name="DiskElapsed" DockPanel.Dock="Right" FontSize="11" Foreground="#657A6B"/><TextBlock x:Name="DiskState" Text="Sẵn sàng · chỉ đọc" FontWeight="SemiBold"/></DockPanel><ProgressBar x:Name="DiskProgress" Height="7" Margin="0,8,0,8" Foreground="#176B51"/><TextBlock x:Name="DiskStatus" Text="Quét temp, file lớn hoặc AppData mặc định theo phạm vi đã chọn. Không đọc nội dung file, không theo junction/cloud, không xóa." TextWrapping="Wrap"/><WrapPanel Margin="0,10,0,0"><Button x:Name="DiskPrevious" Content="Trang trước" IsEnabled="False"/><Button x:Name="DiskNext" Content="Trang tiếp" IsEnabled="False" ToolTip="Quét lại để lấy trang tiếp; dữ liệu có thể đã đổi, không là kế hoạch xóa."/><Button x:Name="DiskDetails" Content="Chi tiết file"/><Button x:Name="DiskReview" IsEnabled="False" Content="Duyệt danh sách..." ToolTip="Xem phạm vi/tác động của mục đã chọn; xóa thật vẫn khóa"/><Button x:Name="DiskWindowsStorage" Content="Dọn bằng Windows" ToolTip="Mở Storage để Windows xử lý temp, update cache, Windows.old; không báo giả dung lượng đã dọn"/><Button x:Name="DiskWindowsApps" Content="Ứng dụng đã cài"/><Button x:Name="DiskTransactions" Content="Thử giao dịch / phục hồi" ToolTip="Tạo và thao tác file mẫu riêng; không dùng dữ liệu cá nhân"/><Button x:Name="DiskClean" Content="Dọn Temp có duyệt..." ToolTip="File .tmp/.log cũ ngay trong Temp của user; hai bước duyệt, quyền user, không có Undo."/><TextBlock Text="Ứng viên cần xác minh; chưa cấp quyền xóa." Foreground="#657A6B" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel></StackPanel></Border>
 </Grid>
</UserControl>
