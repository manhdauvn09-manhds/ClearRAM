<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MemoryClear · Dọn Temp có duyệt" Width="1020" Height="690" MinWidth="850" MinHeight="600" Background="#F3F6F0" WindowStartupLocation="CenterOwner">
 <Grid Margin="22" Background="#F3F6F0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="#173C33" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Dọn Temp của tài khoản hiện tại" Foreground="#D7F49B" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="TempScope" Foreground="White" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
 <StackPanel Grid.Row="1" Margin="0,14,0,12"><TextBlock Text="Chỉ file .tmp / .log cũ ngay trong Temp. Không quét thư mục con, không đóng app, không nâng quyền." TextWrapping="Wrap"/><TextBlock Text="File tạm cũ vẫn có thể chứa dữ liệu khôi phục/cài đặt. Xóa vĩnh viễn, không có Undo. Chọn sau khi đọc tác động." Foreground="#8E481C" TextWrapping="Wrap" Margin="0,6,0,0"/><Button x:Name="TempSelectAll" Content="Chọn tất cả sau khi đã đọc tác động" HorizontalAlignment="Left" Margin="0,9,0,0" Padding="12,7"/></StackPanel>
 <DataGrid x:Name="TempFiles" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" SelectionMode="Extended"><DataGrid.Columns>
  <DataGridTemplateColumn Header="Chọn" Width="55" MinWidth="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"><CheckBox.Style><Style TargetType="CheckBox"><Style.Triggers><DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  <DataGridTextColumn Header="File" Binding="{Binding Name}" IsReadOnly="True" Width="200" MinWidth="200"/>
  <DataGridTextColumn Header="MB" Binding="{Binding MB}" IsReadOnly="True" Width="70" MinWidth="70"/>
  <DataGridTextColumn Header="Ngày" Binding="{Binding AgeDays}" IsReadOnly="True" Width="60" MinWidth="60"/>
  <DataGridTemplateColumn Header="Tác động khi xóa" Width="*" MinWidth="320"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Effect}" TextWrapping="Wrap" Margin="5" ToolTip="{Binding Path}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="TempStage" FontWeight="SemiBold"/><CheckBox x:Name="TempAck" Content="Bước 2: Tôi chấp nhận xóa vĩnh viễn đúng các file đã duyệt ở bước 1." Margin="0,9" Visibility="Collapsed"/><ProgressBar x:Name="TempProgress" Height="8" Foreground="#176B51"/><TextBlock x:Name="TempStatus" Margin="0,8" TextWrapping="Wrap"/></StackPanel>
 <WrapPanel Grid.Row="4" HorizontalAlignment="Right"><Button x:Name="TempBack" Content="Quay lại / quét lại" Padding="13,8" Margin="5"/><Button x:Name="TempNext" Content="Bước 1 · Duyệt các file đã chọn" Padding="13,8" Margin="5"/><Button x:Name="TempRun" Content="Bước 2 · Xóa vĩnh viễn" Background="#176B51" Foreground="White" Padding="13,8" Margin="5"/><Button x:Name="TempStop" Content="Dừng" Padding="13,8" Margin="5"/><Button x:Name="TempClose" Content="Đóng" Padding="13,8" Margin="5"/></WrapPanel>
 </Grid>
</Window>
