<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MemoryClear · Lịch sử thao tác" Width="1020" Height="640" MinWidth="820" MinHeight="480" Background="#F3F6F0" WindowStartupLocation="CenterOwner">
 <Grid Margin="22" Background="#F3F6F0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="#173C33" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Lịch sử dọn Temp và đóng app (Memory mức 3)" Foreground="#D7F49B" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="HistorySummary" Foreground="White" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
 <WrapPanel Grid.Row="1" Margin="0,14,0,12" VerticalAlignment="Center"><TextBlock Text="Loại:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="HistoryType" Width="150" SelectedIndex="0"><ComboBoxItem Content="Tất cả" Tag="All"/><ComboBoxItem Content="Dọn Temp" Tag="Temp"/><ComboBoxItem Content="Memory mức 3" Tag="Memory"/></ComboBox><TextBlock Text="Chỉ đọc nhật ký trong .data; không sửa, không xóa, không chạy lại thao tác nào." Foreground="#657A6B" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/></WrapPanel>
 <DataGrid x:Name="HistoryRuns" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" EnableRowVirtualization="True" SelectionMode="Single" HeadersVisibility="Column"><DataGrid.Columns>
  <DataGridTextColumn Header="Bắt đầu" Binding="{Binding Started}" Width="140" MinWidth="140"/>
  <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="110" MinWidth="110"/>
  <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="130" MinWidth="130"/>
  <DataGridTextColumn Header="Nhật ký" Binding="{Binding Integrity}" Width="120" MinWidth="120"/>
  <DataGridTextColumn Header="Mục" Binding="{Binding Items}" Width="50" MinWidth="50"/>
  <DataGridTextColumn Header="Xong" Binding="{Binding Done}" Width="50" MinWidth="50"/>
  <DataGridTextColumn Header="Giữ" Binding="{Binding Held}" Width="50" MinWidth="50"/>
  <DataGridTextColumn Header="Bỏ qua" Binding="{Binding Skipped}" Width="60" MinWidth="60"/>
  <DataGridTemplateColumn Header="Ghi chú" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="5,2" ToolTip="{Binding File}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns></DataGrid>
 <TextBlock x:Name="HistoryStatus" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#3D5246"/>
 <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="HistoryRefresh" Content="Làm mới" Padding="13,8" Margin="5"/><Button x:Name="HistoryClose" Content="Đóng" Padding="13,8" Margin="5" IsCancel="True"/></WrapPanel>
 </Grid>
</Window>
