{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "governs",
    "executionEnabled",
    "maximumBytes",
    "maximumProfiles",
    "maximumMatches",
    "maximumAgeDays"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "governs": {
      "const": "product_runtime"
    },
    "executionEnabled": {
      "const": false
    },
    "maximumBytes": {
      "type": "integer",
      "minimum": 4096,
      "maximum": 1048576
    },
    "maximumProfiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "maximumMatches": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maximumAgeDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    }
  }
}
