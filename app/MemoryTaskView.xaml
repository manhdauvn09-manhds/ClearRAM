<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MemoryClear · Mức 3 — Danh sách opt-in" Width="1020" Height="650" MinWidth="850" MinHeight="560" Background="#F3F6F0" WindowStartupLocation="CenterOwner">
 <Grid Margin="22" Background="#F3F6F0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="#173C33" Padding="20" CornerRadius="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="03 · Giải phóng tác vụ đã cho phép" Foreground="#D7F49B" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Danh sách Cho đóng gấp của bạn · mặc định trống · không tự force kill" Foreground="White" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
 <DataGrid x:Name="TaskItems" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="App / PID" Binding="{Binding Name}" Width="170" MinWidth="170"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65" MinWidth="65"/><DataGridTextColumn Header="RAM MB" Binding="{Binding RamMB}" Width="85" MinWidth="85"/><DataGridTemplateColumn Header="Tác động / vì sao giữ lại" Width="*" MinWidth="430"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="6" ToolTip="{Binding Path}"><TextBlock Text="{Binding Reason}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Effect}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="2" Margin="0,14,0,0"><CheckBox x:Name="TaskAck" Content="Tôi đã đọc tác động và chấp nhận gửi yêu cầu đóng nhẹ tới các app opt-in đủ điều kiện ở trên." Margin="0,0,0,10"/><ProgressBar x:Name="TaskProgress" Height="8" Foreground="#176B51"/><TextBlock x:Name="TaskStatus" Margin="0,9" TextWrapping="Wrap"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="TaskRescan" Content="Lập danh sách mới" Padding="14,8" Margin="5"/><Button x:Name="TaskExecute" Content="Đóng nhẹ danh sách opt-in" IsEnabled="False" Padding="14,8" Margin="5"/><Button x:Name="TaskCancel" Content="Dừng" Padding="14,8" Margin="5"/><Button x:Name="TaskClose" Content="Đóng" Padding="14,8" Margin="5"/></WrapPanel></StackPanel>
 </Grid>
</Window>
