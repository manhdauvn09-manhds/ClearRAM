{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["governs","schemaVersion","productionExecutionEnabled","maximumItems","ttlSeconds","maximumHistoryRows","maximumJournalBytes","fixtureRules","blockedNames","systemProviderMode"],
 "properties":{
  "$schema":{"type":"string"},"governs":{"const":"product_runtime"},"schemaVersion":{"const":1},"productionExecutionEnabled":{"const":false},
  "maximumItems":{"type":"integer","minimum":1,"maximum":100},"ttlSeconds":{"type":"integer","minimum":1,"maximum":600},
  "maximumHistoryRows":{"type":"integer","minimum":1,"maximum":200},"maximumJournalBytes":{"type":"integer","minimum":4096,"maximum":16777216},
  "fixtureRules":{"type":"object","additionalProperties":false,"required":[".tmp",".log",".db"],"properties":{".tmp":{"const":"Safe"},".log":{"const":"Review"},".db":{"const":"Danger"}}},
  "blockedNames":{"const":[".memoryclear-fixture"]},"systemProviderMode":{"const":"WindowsDelegated"}
 }
}
