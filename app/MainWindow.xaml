<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MemoryClear — RAM &amp; CPU" Width="1120" Height="780" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F3F6F1" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#CAD9CD"/><Setter Property="Foreground" Value="#173C33"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CAD9CD"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Grid Margin="24" Background="#F3F6F1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#173C33" CornerRadius="16" Padding="24,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="MemoryClear" Foreground="#D7F49B" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Thu hồi RAM một chạm · Giữ nguyên ứng dụng và dữ liệu" Foreground="#D2E2D5" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="ClearMemory" Content="Clear" FontSize="21" FontWeight="SemiBold" Background="#D7F49B" Foreground="#173C33" MinWidth="180" Margin="0" ToolTip="Không cần chọn. Thu hồi working set của process đủ điều kiện; không đóng/kill app. RAM có thể nạp lại."/><CheckBox x:Name="StrongClear" Content="Clear mạnh hơn" Foreground="#D7F49B" Margin="0,8,0,0" ToolTip="Xét nhiều process hơn, vẫn giữ bảo vệ và không đóng app. Có thể làm app nạp RAM lại nhiều hơn khi dùng tiếp."/><TextBlock Text="Không đóng app · RAM có thể nạp lại" Foreground="#D2E2D5" FontSize="10" Margin="0,5,0,0"/></StackPanel></Grid></Border>
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,14">
      <Border Background="White" Padding="18" Margin="0,0,10,0" CornerRadius="12"><StackPanel><TextBlock Text="RAM khả dụng / Tổng RAM" Foreground="#657A6B"/><TextBlock x:Name="RamLabel" Text="Đang đọc..." FontSize="27" Foreground="#173C33" Margin="0,8,0,0"/><ProgressBar x:Name="RamBar" Height="5" Margin="0,10,0,0" Maximum="100" Foreground="#A9C771"/></StackPanel></Border>
      <Border Background="White" Padding="18" Margin="0,0,10,0" CornerRadius="12"><StackPanel><TextBlock Text="CPU toàn máy" Foreground="#657A6B"/><TextBlock x:Name="CpuLabel" Text="Chờ mẫu thứ hai..." FontSize="27" Foreground="#173C33" Margin="0,8,0,0"/><ProgressBar x:Name="CpuBar" Height="5" Margin="0,10,0,0" Maximum="100" Foreground="#176B51"/></StackPanel></Border>
      <Border Background="White" Padding="18" CornerRadius="12"><StackPanel><TextBlock Text="Commit / Giới hạn commit" Foreground="#657A6B"/><TextBlock x:Name="CommitLabel" Text="Đang đọc..." FontSize="25" Foreground="#173C33" Margin="0,8,0,0"/><TextBlock Text="Private MB là cấp phát riêng, khác RAM vật lý." FontSize="10" Foreground="#657A6B" Margin="0,10,0,0"/></StackPanel></Border>
    </UniformGrid>
    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" ToolTip="Tìm tên process, PID hoặc đường dẫn"/><CheckBox Grid.Column="1" x:Name="ActionableOnly" Content="Chỉ process có thể thao tác" VerticalAlignment="Center" Margin="16,0"/><Button Grid.Column="2" x:Name="Refresh" Content="Quét lại" Margin="0"/></Grid>
    <DataGrid Grid.Row="3" x:Name="Processes" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="White" BorderBrush="#CAD9CD" GridLinesVisibility="Horizontal" RowHeight="33" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Chọn" Width="55" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Mode=TwoWay}" ToolTip="Chọn process cho các nút thao tác bên dưới" Tag="MCSelect"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="170"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65"/><DataGridTextColumn Header="RAM MB ↓" Binding="{Binding RamMB}" Width="95"/><DataGridTextColumn Header="Private MB" Binding="{Binding PrivateMB}" Width="100"/><DataGridTextColumn Header="CPU %" Binding="{Binding Cpu}" Width="75"/><DataGridTextColumn Header="Chính sách" Binding="{Binding Policy}" Width="200"/>
        <DataGridTemplateColumn Header="Cho đóng gấp" Width="100" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding AllowClose, Mode=OneWay}" IsEnabled="{Binding Allowed}" Tag="MCAllowClose" ToolTip="Cho phép executable này trong danh sách đóng khẩn cấp; không đóng process ngay"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Executable" Binding="{Binding Path}" Width="*" MinWidth="130"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Margin="0,14,0,0"><WrapPanel><Button x:Name="CloseSelected" Content="Đóng process đã chọn"/><Button x:Name="KillSelected" Content="Force kill..." Foreground="#9D4F32"/><Button x:Name="Protect" Content="Bảo vệ / Bỏ bảo vệ"/><Button x:Name="AllowClose" Content="Cho phép / Bỏ đóng khẩn cấp"/><Button x:Name="Details" Content="Chi tiết"/></WrapPanel><WrapPanel Margin="0,10,0,0" VerticalAlignment="Center"><TextBlock Text="Mục tiêu RAM khả dụng:" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="TargetGB" Text="2" Width="65" Margin="0,0,8,0"/><TextBlock Text="GB" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="Emergency" Content="Đóng khẩn cấp theo danh sách..." Background="#176B51" Foreground="White"/><Button x:Name="CancelOperation" Content="Dừng các bước tiếp theo" IsEnabled="False"/></WrapPanel></StackPanel>
    <Border Grid.Row="5" Background="#E7EFDF" Padding="13" CornerRadius="9" Margin="0,14,0,0"><StackPanel><DockPanel Margin="0,0,0,6"><TextBlock x:Name="ClearElapsed" DockPanel.Dock="Right" Text="" Foreground="#657A6B" FontSize="11"/><TextBlock x:Name="ClearState" Text="Clear · Sẵn sàng" FontWeight="SemiBold" Foreground="#244B36"/></DockPanel><ProgressBar x:Name="ClearProgress" Height="7" Minimum="0" Maximum="100" Value="0" Foreground="#176B51" Margin="0,0,0,8"/><TextBlock x:Name="Status" Text="Đang khởi tạo. Chưa thực hiện thao tác đóng/kill." TextWrapping="Wrap" Foreground="#244B36"/><TextBlock x:Name="SelectionLabel" Text="Chọn process để xem và thao tác. Các ô trống là số liệu chưa xác minh, không phải 0." TextWrapping="Wrap" Foreground="#657A6B" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
  </Grid>
</Window>
